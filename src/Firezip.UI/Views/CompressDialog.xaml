<ContentDialog
    x:Class="Firezip.UI.Views.CompressDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="New Archive"
    PrimaryButtonText="Create"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <StackPanel Spacing="14" Width="450">
        <TextBox x:Name="ArchiveNameBox"
                 Header="Archive Name"
                 Text="Archive" />

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="DestinationFolderBox"
                     Header="Save Location" />

            <Button Grid.Column="1"
                    VerticalAlignment="Bottom"
                    Content="Browse..."
                    Click="OnBrowseLocationClick" />
        </Grid>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ComboBox x:Name="FormatComboBox"
                      Header="Archive Format"
                      SelectedIndex="0"
                      HorizontalAlignment="Stretch">
                <ComboBoxItem Content="ZIP (.zip)" />
                <ComboBoxItem Content="7-Zip (.7z)" />
                <ComboBoxItem Content="TAR (.tar)" />
                <ComboBoxItem Content="GZIP (.tar.gz)" />
            </ComboBox>

            <ComboBox x:Name="LevelComboBox"
                      Grid.Column="1"
                      Header="Compression Level"
                      SelectedIndex="2"
                      HorizontalAlignment="Stretch">
                <ComboBoxItem Content="Store (No compression)" />
                <ComboBoxItem Content="Fast" />
                <ComboBoxItem Content="Normal (Recommended)" />
                <ComboBoxItem Content="Maximum" />
                <ComboBoxItem Content="Ultra" />
            </ComboBox>
        </Grid>

        <PasswordBox x:Name="PasswordBox"
                     Header="Encryption Password (Optional)"
                     PasswordRevealMode="Peek"
                     PlaceholderText="Leave blank for no password" />

        <CheckBox x:Name="EncryptHeaderCheckBox"
                  Content="Encrypt file names (7z only)" />

        <TextBox x:Name="ExcludePatternsBox"
                 Header="Exclude patterns (optional)"
                 PlaceholderText="Example: *.tmp; cache/*"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 Height="58" />

        <CheckBox x:Name="PreserveTimestampsCheckBox"
                  Content="Preserve file timestamps"
                  IsChecked="True" />

        <ComboBox x:Name="SplitVolumeBox"
                  Header="Split into volumes (7z only)"
                  SelectedIndex="0"
                  HorizontalAlignment="Stretch">
            <ComboBoxItem Content="Single file (Do not split)" />
            <ComboBoxItem Content="10 MB Parts" />
            <ComboBoxItem Content="100 MB Parts" />
            <ComboBoxItem Content="700 MB Parts (CD)" />
            <ComboBoxItem Content="4,700 MB Parts (DVD)" />
        </ComboBox>
    </StackPanel>
</ContentDialog>

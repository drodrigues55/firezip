<ContentDialog
    x:Class="Firezip.UI.Views.ConflictDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="File Already Exists"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <StackPanel Spacing="16" Width="420">
        <TextBlock x:Name="MessageBlock"
                   TextWrapping="Wrap" />

        <CheckBox x:Name="ApplyToAllCheckBox"
                  Content="Apply this decision to all remaining conflicts" />

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Content="Replace"
                    HorizontalAlignment="Stretch"
                    Style="{ThemeResource AccentButtonStyle}"
                    Click="OnReplaceClick" />

            <Button Grid.Column="1"
                    Content="Skip"
                    HorizontalAlignment="Stretch"
                    Click="OnSkipClick" />

            <Button Grid.Column="2"
                    Content="Rename"
                    HorizontalAlignment="Stretch"
                    Click="OnRenameClick" />
        </Grid>
    </StackPanel>
</ContentDialog>

<ContentDialog
    x:Class="Firezip.UI.Views.AboutDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Sobre o Firezip"
    CloseButtonText="Fechar"
    DefaultButton="Close">

    <Grid Width="420" RowSpacing="16" Margin="0,8,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- App Header with Icon -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
            <Image Source="ms-appx:///Assets/Square44x44Logo.scale-200.png"
                   Width="56" Height="56" />
            <StackPanel VerticalAlignment="Center" Spacing="2">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="Firezip" FontSize="22" FontWeight="Bold" />
                    <Border Background="{ThemeResource AccentFillColorDefaultBrush}"
                            CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                        <TextBlock x:Name="VersionBadgeTextBlock" Text="v1.0.1" FontSize="11" Foreground="White" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>
                <TextBlock x:Name="TaglineTextBlock"
                           Text="O compactador veloz, moderno e nativo para Windows 11."
                           FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </StackPanel>

        <!-- Details Card -->
        <Border Grid.Row="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
            <StackPanel Spacing="10">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Plataforma:" FontWeight="SemiBold" FontSize="12" />
                    <TextBlock Grid.Column="1" Text=".NET 10 | WinUI 3 | Windows App SDK" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Licença:" FontWeight="SemiBold" FontSize="12" />
                    <TextBlock Grid.Column="1" Text="MIT License (100% Gratuito e Livre)" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Copyright:" FontWeight="SemiBold" FontSize="12" />
                    <TextBlock Grid.Column="1" Text="© 2026 Firezip Open Source Team" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Links and Action -->
        <StackPanel Grid.Row="2" Spacing="8">
            <HyperlinkButton Content="Repositório no GitHub: github.com/drodrigues55/firezip"
                             NavigateUri="https://github.com/drodrigues55/firezip"
                             Padding="0" />
            <HyperlinkButton Content="Reportar um problema / Sugerir melhoria"
                             NavigateUri="https://github.com/drodrigues55/firezip/issues"
                             Padding="0" />
        </StackPanel>
    </Grid>
</ContentDialog>

<ContentDialog
    x:Class="Firezip.UI.Views.PasswordDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Encrypted Archive"
    PrimaryButtonText="OK"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <StackPanel Spacing="12" Width="360">
        <TextBlock Text="This archive is encrypted with a password. Please enter the password to continue."
                   TextWrapping="Wrap" />

        <PasswordBox x:Name="PasswordInput"
                     Header="Password"
                     PasswordRevealMode="Peek"
                     PlaceholderText="Enter archive password" />
    </StackPanel>
</ContentDialog>

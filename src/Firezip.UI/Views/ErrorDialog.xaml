<ContentDialog
    x:Class="Firezip.UI.Views.ErrorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Firezip"
    CloseButtonText="Close"
    DefaultButton="Close">

    <StackPanel Spacing="14" Width="460">
        <TextBlock x:Name="MessageBlock" TextWrapping="Wrap" />

        <Button x:Name="DetailsButton"
                Content="Show technical details"
                HorizontalAlignment="Left"
                Click="OnDetailsClick" />

        <StackPanel x:Name="DetailsPanel" Spacing="8" Visibility="Collapsed">
            <TextBox x:Name="DetailsTextBox"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     MinHeight="100"
                     MaxHeight="200"
                     IsSpellCheckEnabled="False"
                     FontFamily="Consolas, Cascadia Mono"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" />
            <Button Content="Copy details" HorizontalAlignment="Right" Click="OnCopyDetailsClick" />
        </StackPanel>
    </StackPanel>
</ContentDialog>

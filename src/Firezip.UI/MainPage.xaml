<Page
    x:Class="Firezip.UI.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Firezip.UI"
    xmlns:vm="using:Firezip.UI.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Menu Bar -->
        <MenuBar Grid.Row="0">
            <MenuBarItem Title="File">
                <MenuFlyoutItem Text="Open Archive..." Click="OnOpenArchiveClick">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="O" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="New Archive..." Click="OnNewArchiveClick">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="N" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Extract All..." Click="OnExtractAllClick"
                                IsEnabled="{x:Bind ViewModel.HasArchive, Mode=OneWay}" />
                <MenuFlyoutItem Text="Extract Selected..." Click="OnExtractSelectedClick"
                                IsEnabled="{x:Bind ViewModel.HasArchive, Mode=OneWay}" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Exit" Click="OnExitClick" />
            </MenuBarItem>

            <MenuBarItem Title="Actions">
                <MenuFlyoutItem Text="Extract to Folder" Click="OnExtractToFolderClick"
                                IsEnabled="{x:Bind ViewModel.HasArchive, Mode=OneWay}" />
                <MenuFlyoutItem Text="Add Files to Archive..." Click="OnAddFilesClick"
                                IsEnabled="{x:Bind ViewModel.HasArchive, Mode=OneWay}" />
                <MenuFlyoutItem Text="Delete Selected" Click="OnDeleteClick"
                                IsEnabled="{x:Bind ViewModel.HasArchive, Mode=OneWay}" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Test Archive Integrity" Click="OnTestArchiveClick"
                                IsEnabled="{x:Bind ViewModel.HasArchive, Mode=OneWay}" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Refresh" Click="OnRefreshClick"
                                IsEnabled="{x:Bind ViewModel.HasArchive, Mode=OneWay}">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F5" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
            </MenuBarItem>

            <MenuBarItem Title="Tools">
                <MenuFlyoutItem Text="Settings &amp; Integration..." Click="OnSettingsClick" />
            </MenuBarItem>

            <MenuBarItem Title="Help">
                <MenuFlyoutItem Text="Check for Updates..." Click="OnCheckForUpdatesMenuClick" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="About Firezip..." Click="OnAboutClick" />
            </MenuBarItem>
        </MenuBar>

        <!-- 2. Action Command Bar (Toolbar) -->
        <CommandBar Grid.Row="1" DefaultLabelPosition="Right" HorizontalAlignment="Left" Background="Transparent">
            <AppBarButton x:Name="OpenAppBarButton" Icon="OpenFile" Label="Open" ToolTipService.ToolTip="Open Archive (Ctrl+O)" Click="OnOpenArchiveClick" />
            <AppBarButton x:Name="ExtractAppBarButton" Icon="Download" Label="Extract" ToolTipService.ToolTip="Extract files from archive"
                          IsEnabled="{x:Bind ViewModel.HasArchive, Mode=OneWay}" Click="OnExtractAllClick" />
            <AppBarButton x:Name="NewAppBarButton" Icon="NewWindow" Label="New Archive" ToolTipService.ToolTip="Create new archive (Ctrl+N)" Click="OnNewArchiveClick" />
            <AppBarSeparator />
            <AppBarButton x:Name="AddAppBarButton" Icon="Add" Label="Add" ToolTipService.ToolTip="Add files to current archive"
                          IsEnabled="{x:Bind ViewModel.HasArchive, Mode=OneWay}" Click="OnAddFilesClick" />
            <AppBarButton x:Name="DeleteAppBarButton" Icon="Delete" Label="Delete" ToolTipService.ToolTip="Delete selected items (Delete)"
                          IsEnabled="{x:Bind ViewModel.HasArchive, Mode=OneWay}" Click="OnDeleteClick" />
            <AppBarSeparator />
            <AppBarButton x:Name="TestAppBarButton" Icon="Accept" Label="Test" ToolTipService.ToolTip="Test archive integrity"
                          IsEnabled="{x:Bind ViewModel.HasArchive, Mode=OneWay}" Click="OnTestArchiveClick" />
            <AppBarButton x:Name="RefreshAppBarButton" Icon="Refresh" Label="Refresh" ToolTipService.ToolTip="Refresh view (F5)"
                          IsEnabled="{x:Bind ViewModel.HasArchive, Mode=OneWay}" Click="OnRefreshClick" />
            <AppBarSeparator />
            <AppBarButton x:Name="SettingsAppBarButton" Icon="Setting" Label="Settings" ToolTipService.ToolTip="Configure Firezip &amp; Windows Explorer integration" Click="OnSettingsClick" />
            <AppBarButton x:Name="AboutAppBarButton" Icon="Help" Label="About" ToolTipService.ToolTip="About Firezip" Click="OnAboutClick" />
        </CommandBar>

        <!-- 3. Address and Search Bar -->
        <Border Grid.Row="2" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,1" Padding="8,6">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="240" />
                </Grid.ColumnDefinitions>

                <Button x:Name="CloseArchiveButton"
                        ToolTipService.ToolTip="Close archive and return to home"
                        IsEnabled="{x:Bind ViewModel.HasArchive, Mode=OneWay}"
                        Click="OnCloseArchiveClick">
                    <FontIcon Glyph="&#xE711;" FontSize="14" />
                </Button>

                <Button x:Name="UpButton"
                        Grid.Column="1"
                        ToolTipService.ToolTip="Up to parent folder (Backspace)"
                        IsEnabled="{x:Bind ViewModel.HasArchive, Mode=OneWay}"
                        Click="OnUpClick">
                    <FontIcon Glyph="&#xE751;" FontSize="14" />
                </Button>

                <TextBox x:Name="PathBox"
                         Grid.Column="2"
                         IsReadOnly="True"
                         Text="{x:Bind ViewModel.CurrentFolderPath, Mode=OneWay}"
                         PlaceholderText="Archive Root (/)" />

                <AutoSuggestBox x:Name="SearchBox"
                                Grid.Column="3"
                                PlaceholderText="Search entries..."
                                QueryIcon="Find"
                                Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
        </Border>

        <!-- 4. Main Body Area -->
        <Grid Grid.Row="3">
            <!-- Empty / Welcome Drop-Zone State -->
            <StackPanel x:Name="WelcomePanel"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="16"
                        Visibility="{x:Bind InverseBooleanToVisibility(ViewModel.HasArchive), Mode=OneWay}">
                <FontIcon Glyph="&#xF012;" FontSize="56" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="Welcome to Firezip" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="Fast, free, and secure Windows archive manager."
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Drag and drop any archive or file here to open, or choose an action:"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           FontSize="12"
                           HorizontalAlignment="Center" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12" Margin="0,8,0,0">
                    <Button Style="{ThemeResource AccentButtonStyle}" Padding="16,8" Click="OnOpenArchiveClick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                            <TextBlock Text="Open Archive..." />
                        </StackPanel>
                    </Button>
                    <Button Padding="16,8" Click="OnNewArchiveClick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" FontSize="14" />
                            <TextBlock Text="New Archive..." />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>

            <!-- Loaded Archive View -->
            <Grid x:Name="ArchiveContentPanel"
                  Visibility="{x:Bind BooleanToVisibility(ViewModel.HasArchive), Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Column Headers -->
                <Border Grid.Row="0" Background="{ThemeResource SubtleFillColorSecondaryBrush}" Padding="12,8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="220" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="90" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Name" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="1" Text="Size" FontWeight="SemiBold" FontSize="12" TextAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="2" Text="Packed" FontWeight="SemiBold" FontSize="12" TextAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="3" Text="Modified" FontWeight="SemiBold" FontSize="12" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="4" Text="Ratio" FontWeight="SemiBold" FontSize="12" TextAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="5" Text="CRC32" FontWeight="SemiBold" FontSize="12" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </Border>

                <!-- Items ListView -->
                <ListView x:Name="ItemsListView"
                          Grid.Row="1"
                          SelectionMode="Extended"
                          CanDragItems="True"
                          DragItemsStarting="OnArchiveItemsDragStarting"
                          ItemsSource="{x:Bind ViewModel.DisplayItems, Mode=OneWay}"
                          DoubleTapped="OnItemDoubleTapped"
                          SelectionChanged="OnSelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ArchiveItemViewModel">
                            <Grid Height="36" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="220" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>

                                <!-- Name with icon -->
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <FontIcon Glyph="{x:Bind IconGlyph}" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <!-- Size -->
                                <TextBlock Grid.Column="1" Text="{x:Bind FormattedSize}" VerticalAlignment="Center" TextAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                <!-- Compressed Size -->
                                <TextBlock Grid.Column="2" Text="{x:Bind FormattedCompressedSize}" VerticalAlignment="Center" TextAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                <!-- Modified Date -->
                                <TextBlock Grid.Column="3" Text="{x:Bind FormattedModified}" VerticalAlignment="Center" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                <!-- Ratio -->
                                <TextBlock Grid.Column="4" Text="{x:Bind FormattedRatio}" VerticalAlignment="Center" TextAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                <!-- CRC -->
                                <TextBlock Grid.Column="5" Text="{x:Bind Crc}" VerticalAlignment="Center" TextAlignment="Center" FontFamily="Consolas, Cascadia Mono" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>

                    <ListView.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="Open / Extract Preview" Click="OnContextOpenClick" />
                            <MenuFlyoutItem Text="Extract Selected..." Click="OnExtractSelectedClick" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Add Files..." Click="OnAddFilesClick" />
                            <MenuFlyoutItem Text="Delete" Click="OnDeleteClick" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Copy Name" Click="OnContextCopyNameClick" />
                            <MenuFlyoutItem Text="Copy Path" Click="OnContextCopyPathClick" />
                        </MenuFlyout>
                    </ListView.ContextFlyout>
                </ListView>
            </Grid>

            <!-- Busy Progress Overlay -->
            <Grid Background="#7F000000"
                  Visibility="{x:Bind BooleanToVisibility(ViewModel.IsBusy), Mode=OneWay}"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch">
                <Border Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="24"
                        Width="440"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <StackPanel Spacing="14">
                        <TextBlock Text="{x:Bind ViewModel.BusyTitle, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Bind ViewModel.BusyDetails, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />

                        <ProgressBar Value="{x:Bind ViewModel.OperationPercent, Mode=OneWay}" Maximum="100" />

                        <Grid>
                            <TextBlock Text="{x:Bind ViewModel.OperationSpeed, Mode=OneWay}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="11" />
                            <TextBlock Text="{x:Bind ViewModel.OperationEta, Mode=OneWay}" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="11" />
                        </Grid>

                        <Button Content="Cancel"
                                HorizontalAlignment="Right"
                                Margin="0,8,0,0"
                                Click="OnCancelOperationClick" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- 5. In-App Notification InfoBar -->
        <InfoBar x:Name="NotificationBar" Grid.Row="4" IsOpen="False" Margin="12,4" />

        <!-- 6. Bottom Status Bar -->
        <Border Grid.Row="5" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="12,6">
            <Grid>
                <TextBlock Text="{x:Bind ViewModel.SelectionStatusText, Mode=OneWay}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
            </Grid>
        </Border>
    </Grid>
</Page>
